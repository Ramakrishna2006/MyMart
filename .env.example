# Copy this file to ".env" and change the values you need.
# Every setting is optional - the defaults work on localhost.

# Flask secret used to sign login cookies. Use a long random string.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1

# Database (default: SQLite file at backend/instance/mymart.db)
# DATABASE_URL=sqlite:///absolute/path/to/mymart.db

# Admin account created on first run
ADMIN_EMAIL=admin@mymart.com
ADMIN_PASSWORD=Admin@123

# Password for all 60 demo customers in data/customers.csv
DEMO_CUSTOMER_PASSWORD=Customer@123

# Load data/*.csv automatically when the database is empty
AUTO_SEED=true

# UPI QR code at checkout - put YOUR UPI ID here
MERCHANT_UPI_ID=mymart@upi
MERCHANT_NAME=My Mart

# Shop rules
FREE_DELIVERY_ABOVE=499
DELIVERY_FEE=40
LOW_STOCK_THRESHOLD=10
MAX_QTY_PER_ITEM=10
